# Bench-specific values (copy to .env; .env is not committed).
#   uv run --env-file .env pytest hil
# PROFILE = the sketch.yaml profile name, uppercased.
TEST_SERIAL_PORT_ESP32P4=/dev/ttyACM0
TEST_SERIAL_PORT_PEER_P4B_ESP32P4_PEER=/dev/ttyACM1
# classic ESP32 (esp32-d0wd) probe for the UIAPduino CH32V003 jig (E132 wiring); transport is its USB-UART
TEST_SERIAL_PORT_ESP32_V003=/dev/ttyUSB0
