# Copy to .env and explicitly load: uv run --env-file .env pytest ...
TEST_SERIAL_PORT_ESP32=/path/to/stable/probe-port
OEP_TRANSFER_UNIT_ID=replace-with-oep-unit-id
OEP_TRANSFER_FIRMWARE=0.0.31
# Existing common lock shared by every equipment user.
OEP_HW_LOCK=/absolute/path/to/existing/bench.lock
# NEW directory for every run, including repeated transfer of the same firmware.
OEP_TRANSFER_RESULTS=/absolute/path/to/results/new-run
OEP_TRANSFER_SPEC_COMMIT=unknown
