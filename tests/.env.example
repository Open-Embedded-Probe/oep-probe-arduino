# Copy to .env; explicitly load with uv run --env-file .env pytest ...
# Select the matching profile on pytest's command line.
TEST_SERIAL_PORT=/path/to/stable/probe-port
OEP_TRANSFER_UNIT_ID=replace-with-oep-unit-id
OEP_TRANSFER_FIRMWARE=0.0.31
# Existing common lock shared by every equipment user.
OEP_HW_LOCK=/absolute/path/to/existing/bench.lock
# NEW directory for each run, including repeated transfer of the same firmware.
OEP_TRANSFER_RESULTS=/absolute/path/to/results/new-run
OEP_TRANSFER_SPEC_COMMIT=unknown
# Allow unreadable settings/declarations ONLY before updating a known legacy image.
# Identity and silicon checks still apply; post-update checks stay strict.
OEP_TRANSFER_ALLOW_UNREADABLE_CONFIG=0
# Pico: optionally use this explicitly mounted BOOTSEL drive, verified against USB topology.
# Otherwise the pinned core's picotool needs USB access to the bootloader.
# OEP_HW_UF2_DRIVE=/absolute/path/to/mounted/BOOTSEL
# Recovery after this gate checked identity then stopped in BOOTSEL:
# OEP_TRANSFER_RESUME_FROM=/absolute/path/to/previous-run/transfer.json

# Optional independent checks against an explicitly chosen SPEC checkout.
# Run tests/equipment separately; this is not automatic upload or firmware migration.
# OEP_CONFORMANCE_ADDRESS=/absolute/path/to/stable/probe-port
# OEP_CONFORMANCE_UNIT_ID=replace-with-unit-id
# OEP_CONFORMANCE_SPEC=/absolute/path/to/oep-spec-checkout
# OEP_CONFORMANCE_OUT=/absolute/path/to/existing-results-dir/new-core-run.json
# OEP_CONFORMANCE_FRAMING=serial  # independent COBS/CRC and serial fault checks; client for USB/TCP
